{
  "name": "site",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -n site,studio -c blue,green --kill-others-on-fail \"npm run dev:site\" \"npm run dev:studio\"",
    "dev:site": "next dev",
    "dev:studio": "cd studio && npm run dev -- --port 3333",
    "build": "next build",
    "build:site": "next build",
    "build:studio": "cd studio && npm install && npm run build",
    "deploy:studio": "cd studio && npm install && npx sanity deploy",
    "start": "next start",
    "lint": "eslint",
    "prepare": "git config core.hooksPath .githooks 2>/dev/null || true"
  },
  "dependencies": {
    "@fontsource-variable/jetbrains-mono": "^5.2.8",
    "@fontsource-variable/montserrat": "^5.2.8",
    "@fontsource/cormorant-garamond": "^5.2.11",
    "@portabletext/react": "^6.2.0",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-slot": "^1.2.4",
    "@sanity/image-url": "^2.1.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "gsap": "^3.15.0",
    "lenis": "^1.3.23",
    "lucide-react": "^1.16.0",
    "next": "16.2.6",
    "next-sanity": "^13.0.8",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^9.2.1",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "overrides": {
    "postcss": "^8.5.10",
    "js-yaml": "^4.1.0",
    "uuid": "^11.1.1"
  }
}
